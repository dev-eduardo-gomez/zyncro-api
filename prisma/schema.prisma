generator client {
    provider = "prisma-client"
    output = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    MAKER
    CHECKER
    ADMIN
}

enum InvoiceStatus {
    PENDING
    PAID
    OVERDUE
    CANCELLED
    DISPUTED
}

model Customer {
    id String @id @default(uuid()) @db.Uuid
    taxId String @unique @map("tax_id") @db.VarChar(50)
    legalName String @map("legal_name") @db.VarChar(200)
    address String @db.Text
    contactEmail String @map("contact_email") @db.VarChar(100)
    creditDays Int @map("credit_days")
    creditBalance Decimal @map("credit_balance") @default(0) @db.Decimal(15, 2)
    invoices Invoice[]
    createdAt DateTime @map("created_at") @default(now())
    updatedAt DateTime @map("updated_at") @updatedAt

    @@map("customers")
}

model Invoice {
    id String @id @default(uuid()) @db.Uuid
    // Backed by a native Postgres sequence: unique under concurrent inserts (R3).
    folio Int @unique @default(autoincrement())
    customerId String @map("customer_id") @db.Uuid
    currency String @db.Char(3)
    subtotal Decimal @db.Decimal(15, 2)
    tax Decimal @db.Decimal(15, 2)
    total Decimal @db.Decimal(15, 2)
    // Pending amount: total minus applied payments. Updated in the same
    // transaction that records a payment, never negative (R5).
    balance Decimal @db.Decimal(15, 2)
    status InvoiceStatus @default(PENDING)
    dueDate DateTime @map("due_date") @db.Date
    lineItems InvoiceLineItem[]
    payments Payment[]
    createdAt DateTime @map("created_at") @default(now())
    updatedAt DateTime @map("updated_at") @updatedAt

    customer Customer @relation(fields: [customerId], references: [id])

    @@map("invoices")
}

model InvoiceLineItem {
    id String @id @default(uuid()) @db.Uuid
    invoiceId String @map("invoice_id") @db.Uuid
    position Int
    description String @db.Text
    quantity Decimal @db.Decimal(12, 4)
    unitPrice Decimal @map("unit_price") @db.Decimal(15, 2)
    taxRate Decimal @map("tax_rate") @db.Decimal(5, 4)
    lineTotal Decimal @map("line_total") @db.Decimal(15, 2)

    invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    @@unique([invoiceId, position])
    @@map("invoice_line_items")
}

model Payment {
    id String @id @default(uuid()) @db.Uuid
    invoiceId String @map("invoice_id") @db.Uuid
    // What the customer paid = appliedAmount + creditAmount.
    amount Decimal @db.Decimal(15, 2)
    // Portion that lowered the invoice balance.
    appliedAmount Decimal @map("applied_amount") @db.Decimal(15, 2)
    // Excess over the pending balance, added to the customer's credit (R5).
    creditAmount Decimal @map("credit_amount") @db.Decimal(15, 2)
    proofUrl String? @map("proof_url") @db.Text
    createdAt DateTime @map("created_at") @default(now())

    invoice Invoice @relation(fields: [invoiceId], references: [id])

    // GET /invoices/{id}/payments lists them oldest first.
    @@index([invoiceId, createdAt])
    @@map("payments")
}

model User {
    id String @id @default(uuid()) @db.Uuid
    email String @unique @db.VarChar(100)
    passwordHash String @map("password_hash") @db.Text
    role Role @default(MAKER)
    createdAt DateTime @map("created_at") @default(now())
    updatedAt DateTime @map("updated_at") @updatedAt

    @@map("users")
}
