meta {
  name: Create invoice
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/invoices
  body: json
  auth: inherit
}

body:json {
  {
    "customerId": "{{customerId}}",
    "currency": "MXN",
    "lineItems": [
      {
        "description": "Monthly subscription",
        "quantity": 1,
        "unitPrice": "1000.00",
        "taxRate": 0.16
      },
      {
        "description": "Setup fee",
        "quantity": 1.5,
        "unitPrice": "33.33",
        "taxRate": 0
      }
    ]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("invoiceId", res.body.id);
  }
}

assert {
  res.status: eq 201
  res.body.subtotal: eq "1050.00"
  res.body.tax: eq "160.00"
  res.body.total: eq "1210.00"
}

docs {
  Requires `Create customer` first (uses `customerId`).
  Amounts follow R2: per-line half-up rounding, tax rounded once per invoice.
}
